# Origin of ramses-api. In the container this is read at start-up and written
# to runtime-config.js, so one image works against any API. Leave empty for
# `npm run dev`, which proxies /api to http://localhost:8080.
API_BASE=

# Build-time fallback when runtime-config.js sets no API_BASE.
VITE_API_URL=

# Where `npm run dev` forwards /api.
API_PROXY_TARGET=http://localhost:8080
